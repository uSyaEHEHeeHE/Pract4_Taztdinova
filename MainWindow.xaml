<Window x:Class="Pract4_Taztdinova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pract4_Taztdinova"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        MinHeight="450" MinWidth="500">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border BorderBrush="Gray" BorderThickness="1" Margin="10" CornerRadius="10" Width="200">
            <StackPanel Margin="10">
                <Label Content="Фамилия"/>
                <TextBox Margin="5" Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" />
                <Label Content="Имя"/>
                <TextBox Margin="5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Группа"/>
                <TextBox Margin="5" Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Математика"/>
                <TextBox Margin="5" Text="{Binding Math, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Русский"/>
                <TextBox Margin="5" Text="{Binding Russian, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="История"/>
                <TextBox Margin="5" Text="{Binding History, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="10" CornerRadius="10">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Label Content="ID"/>
                    <TextBlock Margin="5" VerticalAlignment="Center" Text="{Binding Id, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="Средний балл:"/>
                    <TextBlock Margin="5" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" Text="{Binding AverageGrade, StringFormat={}{0:F2}}"/>
                </StackPanel>

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Сохранить" Margin="5" x:Name="SaveButton" Click="SaveButton_Click"/>
                    <Button Grid.Column="1" Content="Новая запись" Margin="5" x:Name="NewNoteButton" Click="NewNoteButton_Click"/>
                </Grid>

                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="Поиск по ID"/>
                        <Button Grid.Column="1" Content="Найти" Margin="5" x:Name="SearchButton" Click="SearchButton_Click"/>
                    </Grid>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Margin="5"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>